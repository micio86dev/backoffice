# Backoffice SPA — environment variables
# Copy to .env and fill in the values for your environment.

# Public API base — RELATIVE, and the leading `/` is not optional.
# nginx proxies /api/ from the backoffice's own origin, so the browser talks to
# exactly one site and the `beai_refresh` cookie is first-party. An absolute URL
# makes the api a different SITE (`up.railway.app` is on the Public Suffix List),
# which WebKit blocks as a third-party cookie and Safari operators experience as
# being logged out on every reload. `backoffice/Dockerfile` fails the build on an
# absolute value; this file is the one path that check cannot see.
NUXT_PUBLIC_API_BASE=/api

# Sentry — application error monitoring (C13). Left EMPTY on purpose: the SDK
# does not initialize without a DSN (app/utils/sentry-init.ts). A real value
# is a per-deployment credential and must never be committed.
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=

# Source-map upload at build/deploy time. Leave unset locally — uploads are
# skipped entirely without SENTRY_AUTH_TOKEN (nuxt.config.ts).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
