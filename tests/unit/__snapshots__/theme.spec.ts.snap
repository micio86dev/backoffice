exports[`brand theme token source (regression guard) > :root semantic block matches the known-good snapshot 1`] = `
"--radius: 0.5rem;

  --background: oklch(0.984 0.003 247.858); /* --color-neutral-50 */
  --foreground: oklch(0.279 0.037 260.031); /* --color-neutral-800 */

  --card: oklch(0.968 0.007 247.896); /* --color-neutral-100 */
  --card-foreground: oklch(0.279 0.037 260.031); /* --color-neutral-800 */

  --popover: oklch(1 0 0);
  --popover-foreground: oklch(0.279 0.037 260.031); /* --color-neutral-800 */

  --primary: oklch(0.455 0.213 307.581); /* #771aaf */
  --primary-foreground: oklch(0.985 0 0); /* white, 8.2:1 on primary */

  --secondary: oklch(0.968 0.007 247.896); /* --color-neutral-100 */
  --secondary-foreground: oklch(0.279 0.037 260.031); /* --color-neutral-800 */

  --muted: oklch(0.968 0.007 247.896); /* --color-neutral-100 */
  --muted-foreground: oklch(0.446 0.037 257.281); /* --color-neutral-600 */

  --accent: oklch(0.634 0.187 37.49); /* #e45526 */
  --accent-foreground: oklch(0.208 0.04 265.755); /* --color-neutral-900, AA-safe on accent */

  --destructive: oklch(0.505 0.19 27.518); /* #b91c1c, not #ef4444 (DESIGN.md §9.1) */

  --border: oklch(0.929 0.013 255.508); /* --color-neutral-200 */
  /* D12 — was oklch(0.929 0.013 255.508) / --color-neutral-200 (#e2e8f0 on
     #f8fafc/white ≈ 1.18:1, failing DESIGN.md §9's binding ≥3:1). Referenced
     via var(), not a fresh oklch literal, so this can never drift from the
     --theme-literal hex value DESIGN.md §3.1 documents as the source of
     truth — and because happy-dom's test DOM cannot parse oklch() at all
     (verified during RED), a literal oklch recomputation here would be
     untestable by tests/unit/theme.spec.ts. */
  --input: var(--color-neutral-500);
  --ring: oklch(0.634 0.187 37.49); /* accent — DESIGN.md §16 focus:ring-accent */

  /* Chart palette — unbranded shadcn defaults; no C11 view consumes charts yet */
  --chart-1: oklch(0.646 0.222 41.116);
  --chart-2: oklch(0.6 0.118 184.704);
  --chart-3: oklch(0.398 0.07 227.392);
  --chart-4: oklch(0.828 0.189 84.429);
  --chart-5: oklch(0.769 0.188 70.08);

  /* Sidebar — purple background, white foreground (DESIGN.md §8.1: "--color-primary
     background, white text") */
  --sidebar: oklch(0.455 0.213 307.581); /* #771aaf */
  --sidebar-foreground: oklch(0.985 0 0); /* white, 8.2:1 on primary */
  --sidebar-primary: oklch(0.455 0.213 307.581); /* active item — same brand purple */
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.406 0.209 289.368); /* hover — #4f1aaf primary-dark */
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 15%);
  --sidebar-ring: oklch(0.634 0.187 37.49); /* accent */"
`;

