{
  "name": "backoffice",
  "version": "0.22.3",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "test:unit": "node node_modules/.bin/vitest run",
    "test:unit:coverage": "node node_modules/.bin/vitest run --coverage",
    "test:e2e": "node node_modules/.bin/playwright test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "codegen": "bunx openapi-typescript openapi.json -o types/api.ts",
    "codegen:check": "bash scripts/check-client-drift.sh"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.31.0",
    "@nuxtjs/i18n": "^9.0",
    "@sentry/nuxt": "^10.70.0",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "minimatch": "^10.2.5",
    "nuxt": "^4.0",
    "reka-ui": "^2.10.3",
    "shadcn-vue": "^2.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10",
    "@nuxt/eslint-config": "^1.16.0",
    "@playwright/test": "^1.52",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.0",
    "@vue/test-utils": "^2.4",
    "eslint": "^9.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1",
    "lint-staged": "^15.0",
    "openapi-typescript": "^7.0",
    "prettier": "^3.5",
    "tailwindcss": "^4.0",
    "typescript": "^5.8",
    "vitest": "^3.0",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.0.1",
    "tar": "^7.5.22"
  }
}
